# 이 파일을 복사해서 .env 로 이름을 바꾸고 = 뒤에 값을 붙여넣으세요 (따옴표, 띄어쓰기 없이).
# .env 는 GitHub에 올라가지 않아요. 채팅에 붙여넣지 마세요.

# ① console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ② Meta for Developers → 내 앱 → Threads 사용 사례 → 토큰 생성기
THREADS_ACCESS_TOKEN=
# ② Meta for Developers → 내 앱 → 앱 설정 → 기본 설정 → Threads 앱 시크릿
THREADS_APP_SECRET=

# ③ GitHub → Settings → Developer settings → Fine-grained token (토큰 자동 갱신용)
GH_PAT=
